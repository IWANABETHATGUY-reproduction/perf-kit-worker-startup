index 0000000..36c3680
--- /dev/null
+++ b/src/mcp-client-shim.ts
@@ -0,0 +1,136 @@
+/**
+ * The MCP client is only needed when an agent actually connects to an MCP
+ * server. Keep its implementation out of the Worker's global scope: these
+ * lazy constructors load the real package (and construct the real object) on
+ * first use.
+ */
+type RealModule = typeof import("@modelcontextprotocol/client");
+type Lazy = { __lazyResolve(): Promise<unknown> };
+
+let realModule: Promise<RealModule> | undefined;
+
+function loadReal(): Promise<RealModule> {
+  realModule ??= import("@mcp-real-client");
+  return realModule;
+}
+
+function isLazy(value: unknown): value is Lazy {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    typeof (value as Lazy).__lazyResolve === "function"
+  );
+}
+
+async function unwrap(value: unknown): Promise<unknown> {
+  return isLazy(value) ? await value.__lazyResolve() : value;
+}
+
+async function unwrapArgs(args: unknown[]): Promise<unknown[]> {
+  return Promise.all(args.map(unwrap));
+}
+
+function lazyClass<K extends "Client" | "SSEClientTransport" | "StreamableHTTPClientTransport">(
+  exportName: K
+) {
+  return class LazyExport {
+    private args: unknown[];
+    private real: InstanceType<RealModule[K]> | undefined;
+    private loading: Promise<InstanceType<RealModule[K]>> | undefined;
+
+    constructor(...args: unknown[]) {
+      this.args = args;
+      return new Proxy(this, {
+        get(target, prop, receiver) {
+          if (prop === "__lazyResolve") return () => resolve(target);
+          if (prop in target) return Reflect.get(target, prop, receiver);
+          const real = target.real;
+          if (real) {
+            const value = real[prop as keyof typeof real];
+            return typeof value === "function" ? value.bind(real) : value;
+          }
+          return async (...callArgs: unknown[]) => {
+            const instance = await resolve(target);
+            const value = instance[prop as keyof typeof instance];
+            if (typeof value !== "function") return value;
+            return (value as (...args: unknown[]) => unknown).apply(
+              instance,
+              await unwrapArgs(callArgs)
+            );
+          };
+        },
+        set(target, prop, value) {
+          if (target.real) {
+            (target.real as unknown as Record<PropertyKey, unknown>)[prop] = value;
+          } else {
+            (target as Record<PropertyKey, unknown>)[prop] = value;
+          }
+          return true;
+        }
+      });
+    }
+
+    private async resolve(): Promise<InstanceType<RealModule[K]>> {
+      return resolve(this);
+    }
+
+    private async resolveInstance(): Promise<InstanceType<RealModule[K]>> {
+      return resolve(this);
+    }
+  };
+
+  async function resolve(
+    target: InstanceType<ReturnType<typeof lazyClass>>
+  ): Promise<InstanceType<RealModule[K]>> {
+    const lazy = target as unknown as {
+      args: unknown[];
+      real?: InstanceType<RealModule[K]>;
+      loading?: Promise<InstanceType<RealModule[K]>>;
+    };
+    if (lazy.real) return lazy.real;
+    lazy.loading ??= (async () => {
+      const module = await loadReal();
+      const Constructor = module[exportName] as new (
+        ...args: unknown[]
+      ) => InstanceType<RealModule[K]>;
+      lazy.real = new Constructor(...(await unwrapArgs(lazy.args)));
+      return lazy.real;
+    })();
+    return lazy.loading;
+  }
+}
+
+export const Client = lazyClass("Client");
+export const SSEClientTransport = lazyClass("SSEClientTransport");
+export const StreamableHTTPClientTransport = lazyClass(
+  "StreamableHTTPClientTransport"
+);
+
+/** Error type check used by the MCP transport fallback. */
+export class SdkHttpError extends Error {
+  status?: number;
+
+  static [Symbol.hasInstance](value: unknown): boolean {
+    return (
+      value instanceof Error &&
+      (value.name === "SdkHttpError" ||
+        typeof (value as { status?: unknown }).status === "number")
+    );
+  }
+}
+
+/** SEP-991 URL-based client IDs are optional; preserve the same validation. */
+export function validateClientMetadataUrl(url?: string): void {
+  if (!url) return;
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    parsed = undefined as unknown as URL;
+  }
+  if (!parsed || parsed.protocol !== "https:" || parsed.pathname === "/") {
+    throw new Error(
+      `clientMetadataUrl must be a valid HTTPS URL with a non-root pathname, got: ${url}`
+    );
+  }
+}
