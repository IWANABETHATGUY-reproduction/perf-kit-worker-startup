diff --git a/workers/mcp-validators.ts b/workers/mcp-validators.ts
new file mode 100644
index 0000000..b9a2e61
--- /dev/null
+++ b/workers/mcp-validators.ts
@@ -0,0 +1,49 @@
+import { sValidator } from "@hono/standard-validator"
+import { uniqueSymbol } from "muppet"
+import { z } from "zod/v4"
+
+type JsonSchema = Record<string, unknown>
+
+/**
+ * Same contract as muppet's `mValidator`, but with the JSON Schema supplied
+ * directly. muppet would otherwise need the per-vendor schema-to-JSON-Schema
+ * adapters from `@standard-community/standard-json`, even though this app only
+ * uses Zod.
+ */
+function withJsonSchema<T extends z.ZodType>(
+    schema: T,
+    jsonSchema: JsonSchema,
+) {
+    return Object.assign(sValidator("json", schema), {
+        [uniqueSymbol]: {
+            validationTarget: "json" as const,
+            toJson: { schema: jsonSchema },
+        },
+    })
+}
+
+export const addMemoryValidator = withJsonSchema(
+    z.object({
+        thingToRemember: z.string(),
+    }),
+    {
+        type: "object",
+        properties: { thingToRemember: { type: "string" } },
+        required: ["thingToRemember"],
+        additionalProperties: false,
+        $schema: "http://json-schema.org/draft-07/schema#",
+    },
+)
+
+export const searchMemoriesValidator = withJsonSchema(
+    z.object({
+        informationToGet: z.string(),
+    }),
+    {
+        type: "object",
+        properties: { informationToGet: { type: "string" } },
+        required: ["informationToGet"],
+        additionalProperties: false,
+        $schema: "http://json-schema.org/draft-07/schema#",
+    },
+)
